{
  "name": "3d-gallery",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:models": "node scripts/build-models.mjs",
    "build:model": "node scripts/build-models.mjs",
    "dev": "npm run dev -w @3d-gallery/gallery-app",
    "build": "npm run build:models && npm run build -w @3d-gallery/gallery-app",
    "preview": "npm run preview -w @3d-gallery/gallery-app",
    "test:e2e": "npm run test:e2e -w @3d-gallery/gallery-app",
    "test:e2e:full": "npm run test:e2e:full -w @3d-gallery/gallery-app",
    "test:e2e:ui": "npm run test:e2e:ui -w @3d-gallery/gallery-app",
    "test:build": "node --test tests/build/build.test.mjs",
    "test:build:baseline": "TEST_UPDATE_BASELINE=1 node --test tests/build/build.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.7.0"
  }
}
