node_modules/
dist/
.DS_Store
*.log

# Built model artifacts — produced by scripts/build-models.mjs
public/models/
public/a/
models/*/build/

# Temp per-color wrapper files from build-multicolor-3mf.mjs (normally
# auto-deleted; ignored so a crashed/interrupted build can't leak them in)
models/*/previews/_pass_*.scad

# WASM files — fetched in CI, symlinked locally
public/wasm

# OpenSCAD-WASM assets for the model-forge fallback engine (~24 MB).
# Fetched on demand: npm run fetch-wasm -w @3d-gallery/model-forge
packages/model-forge/assets/

# Playwright e2e artifacts
test-results/
playwright-report/
/blob-report/
/playwright/.cache/

# openscad build cache — content-addressed by scripts/cache.mjs
.cache/

# Build cache — content-hashed openscad artifacts (safe to delete anytime)
.cache/

# Per-dog tag builds (names, microchip IDs, addresses) — local only
/dogs/
